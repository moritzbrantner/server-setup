# Copy to .env and adjust values for your server.
# Load before deploy commands:
#   set -a; source .env; set +a

# Unlighthouse upload target (referenced from deploy/sites.json)
UNLIGHTHOUSE_SERVER_URL=http://127.0.0.1:5678
UNLIGHTHOUSE_SERVER_TOKEN=replace-with-your-token

# Per-site SSH key used in deploy/sites.json via git_ssh_command placeholders.
# Add additional *_DEPLOY_KEY_PATH variables as needed for each site.
MARKETING_SITE_DEPLOY_KEY_PATH=/srv/keys/marketing-site-deploy
