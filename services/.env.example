# Local-only operations dashboards by default.
UPTIME_KUMA_PORT=3001
BESZEL_PORT=8090
BESZEL_APP_URL=http://127.0.0.1:8090

# Optional public routing through Dokploy's Traefik.
# Set both before using ./setup.sh --public-observability.
UPTIME_KUMA_HOST=
BESZEL_HOST=

# Optional local Beszel agent bootstrap.
# Create a universal token/public key in the Beszel hub first, then rerun
# ./setup.sh --with-beszel-agent after filling these values.
BESZEL_KEY=
BESZEL_TOKEN=
