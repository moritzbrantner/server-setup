[Unit]
Description=Watch apps directory and trigger discovery/deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/site-automation
ExecStart=/usr/bin/env bash -lc '${REPO_ROOT}/scripts/watch-apps-and-deploy.sh'
Restart=always
RestartSec=2
