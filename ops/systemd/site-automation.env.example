# Path to this repository on the target host.
REPO_ROOT=/opt/server-setup

# Discovery/deploy runner settings.
APPS_GLOB=/srv/apps/*
CONFIG_PATH=/opt/server-setup/deploy/sites.json
LOCK_FILE=/var/lock/site-discovery-deploy.lock
LOCK_DIR=/var/lock/server-setup
STATE_DIR=/var/lib/server-setup/state
LOG_DIR=/var/log/server-setup
LOG_RETENTION_DAYS=14

# Watcher settings.
APPS_DIR=/srv/apps
DEBOUNCE_SECONDS=5
RUNNER_SERVICE=site-discovery-deploy.service

# Webhook receiver settings.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9001
WEBHOOK_PATH=/github/push
WEBHOOK_SECRET=
WEBHOOK_ALLOW_INSECURE=false
WEBHOOK_ALLOWED_REPOS=
WEBHOOK_ALLOWED_BRANCHES=main
