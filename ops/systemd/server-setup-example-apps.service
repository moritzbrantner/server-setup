[Unit]
Description=Deploy bundled example applications
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=EXAMPLE_APPS_DIR=/srv/apps
ExecStart=/usr/bin/env bash /opt/server-setup/scripts/start-example-apps.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
