[Unit]
Description=Deploy bundled example applications
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=EXAMPLE_APPS_DIR=/srv/apps
ExecStart=/usr/bin/env python3 /opt/server-setup/scripts/start_example_apps.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
