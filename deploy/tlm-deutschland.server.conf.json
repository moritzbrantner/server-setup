{
  "name": "tlm-deutschland",
  "repo": "https://x-access-token:${TLM_DEUTSCHLAND_GITHUB_TOKEN}@github.com/moritzbrantner/tlm-deutschland.git",
  "branch": "main",
  "domain": "tlm-deutschland.de",
  "site_url": "https://tlm-deutschland.de",
  "workdir": "/root/apps/tlm-deutschland",
  "build_output": ".",
  "deploy_hooks": {
    "build": "bun install --frozen-lockfile && bun run build"
  },
  "runtime": {
    "mode": "service",
    "command": "PORT=3001 bun run start",
    "working_dir": ".",
    "user": "root",
    "port": 3001,
    "health_endpoint": "/",
    "health_retries": 20,
    "health_interval_seconds": 2
  },
  "service": {
    "name": "tlm-deutschland.service"
  },
  "nginx": {
    "www_redirect": false,
    "tls_hostnames": [
      "tlm-deutschland.de"
    ]
  }
}
