[
  {
    "name": "tlm-deutschland",
    "repo": "https://github.com/moritzbrantner/tlm-deutschland.git",
    "branch": "main",
    "domain": "tlm-deutschland.de",
    "site_url": "https://tlm-deutschland.de",
    "workdir": "/root/apps/tlm-deutschland",
    "releases_dir": "/root/apps/tlm-deutschland/releases",
    "current_symlink": "/root/apps/tlm-deutschland/current",
    "keep_releases": 5,
    "web_root": null,
    "build_output": ".",
    "deploy_script": null,
    "pre_deploy_cmd": null,
    "build_cmd": "bun install --frozen-lockfile && bun run build",
    "post_deploy_cmd": null,
    "git_ssh_command": null,
    "repo_auth": {
      "github_token": "${TLM_DEUTSCHLAND_GITHUB_TOKEN}",
      "github_username": "x-access-token"
    },
    "unlighthouse_server_url": null,
    "unlighthouse_server_token": null,
    "unlighthouse_cmd": null,
    "runtime": {
      "mode": "service",
      "command": "PORT=3001 bun run start",
      "working_dir": ".",
      "port": 3001,
      "health_endpoint": "/",
      "health_retries": 20,
      "health_interval_seconds": 2,
      "user": "root"
    },
    "service": {
      "name": "tlm-deutschland.service"
    },
    "nginx": {
      "www_redirect": false,
      "tls_hostnames": [
        "tlm-deutschland.de"
      ]
    }
  }
]
